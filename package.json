    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafazafar/chatgpt-gh-issues-plugin.git"
  },
  "homepage": "https://github.com/rafazafar/chatgpt-gh-issues-plugin#readme"
