{
  "name": "issue-launchpad",
  "version": "0.1.3",
  "private": true,
  "description": "Browse GitHub issues and Projects from the Codex sidebar and kick off tasks.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "node ./scripts/dev.mjs",
