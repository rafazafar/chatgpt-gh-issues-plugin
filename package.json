    "build:plugin": "node ./scripts/build.mjs --plugin-dir plugins/issue-launchpad"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/mcp-extensions": "^0.1.0",
